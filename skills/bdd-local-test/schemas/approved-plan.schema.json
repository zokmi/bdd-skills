{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdd-local-test.local/schemas/approved-plan.schema.json",
  "title": "Approved parallel BDD plan",
  "type": "object",
  "properties": {
    "contractVersion": { "enum": [1, 2, 3] },
    "runId": { "type": "string", "pattern": "\\S" },
    "scope": { "enum": ["batch", "non-batch"] },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "pattern": "\\S" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "required": ["path", "sha256"],
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "groupId": { "type": "string", "pattern": "\\S" },
          "repo": { "type": "string", "pattern": "\\S" },
          "revision": {
            "type": "object",
            "properties": {
              "head": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
              "dirtySha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
            },
            "required": ["head", "dirtySha256"],
            "additionalProperties": false
          },
          "engineeringChecks": { "$ref": "https://bdd-local-test.local/schemas/assignment.schema.json#/properties/engineeringChecks" },
          "scenarios": {
            "type": "array",
            "items": {
              "$ref": "https://bdd-local-test.local/schemas/assignment.schema.json#/properties/scenarios/items",
              "properties": {
                "feature": { "pattern": "\\S" },
                "id": { "pattern": "\\S" }
              },
              "required": ["assertions"]
            }
          }
        },
        "required": ["groupId", "repo", "scenarios"],
        "anyOf": [{ "required": ["engineeringChecks"] }, { "properties": { "scenarios": { "minItems": 1 } } }],
        "additionalProperties": false
      }
    }
  },
  "required": ["contractVersion", "runId", "groups"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "contractVersion": { "const": 1 } } },
      "then": { "properties": { "groups": { "items": { "not": { "required": ["revision"] } } } } },
      "else": { "properties": { "groups": { "items": { "required": ["revision"] } } } }
    },
    {
      "if": { "properties": { "contractVersion": { "const": 3 } } },
      "then": { "required": ["scope"] },
      "else": { "not": { "anyOf": [{ "required": ["scope"] }, { "required": ["selections"] }] } }
    },
    {
      "if": { "required": ["scope"], "properties": { "scope": { "const": "batch" } } },
      "then": { "required": ["selections"] },
      "else": {
        "not": { "required": ["selections"] },
        "properties": { "groups": { "items": { "not": { "required": ["engineeringChecks"] } } } }
      }
    }
  ]
}
