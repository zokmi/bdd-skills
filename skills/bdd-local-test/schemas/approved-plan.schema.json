{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdd-local-test.local/schemas/approved-plan.schema.json",
  "title": "Approved parallel BDD plan",
  "type": "object",
  "properties": {
    "contractVersion": { "enum": [1, 2] },
    "runId": { "type": "string", "pattern": "\\S" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "groupId": { "type": "string", "pattern": "\\S" },
          "repo": { "type": "string", "pattern": "\\S" },
          "revision": {
            "type": "object",
            "properties": {
              "head": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
              "dirtySha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
            },
            "required": ["head", "dirtySha256"],
            "additionalProperties": false
          },
          "scenarios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://bdd-local-test.local/schemas/assignment.schema.json#/properties/scenarios/items",
              "properties": {
                "feature": { "pattern": "\\S" },
                "id": { "pattern": "\\S" }
              },
              "required": ["assertions"]
            }
          }
        },
        "required": ["groupId", "repo", "scenarios"],
        "additionalProperties": false
      }
    }
  },
  "required": ["contractVersion", "runId", "groups"],
  "additionalProperties": false,
  "if": { "properties": { "contractVersion": { "const": 2 } } },
  "then": { "properties": { "groups": { "items": { "required": ["revision"] } } } },
  "else": { "properties": { "groups": { "items": { "not": { "required": ["revision"] } } } } }
}
