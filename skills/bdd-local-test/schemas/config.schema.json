{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDD project config",
  "type": "object",
  "properties": {
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frontendPorts": { "$ref": "#/$defs/ports" },
            "apiPorts": { "$ref": "#/$defs/ports" }
          },
          "anyOf": [{ "required": ["frontendPorts"] }, { "required": ["apiPorts"] }]
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ports": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
              "additionalProperties": {
                "oneOf": [
                  { "$ref": "#/$defs/port" },
                  {
                    "type": "object",
                    "required": ["port"],
                    "additionalProperties": false,
                    "properties": {
                      "port": { "$ref": "#/$defs/port" },
                      "protocol": { "enum": ["http", "https"], "default": "https" }
                    }
                  }
                ]
              }
            },
            "timeoutMs": { "$ref": "#/$defs/timeout", "default": 30000 },
            "login": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["endpoint", "fields", "tokenPath"],
                "additionalProperties": false,
                "properties": {
                  "endpoint": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*:/[^/]" },
                  "fields": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "$ref": "#/$defs/nonempty" }
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/$defs/env" }
                  },
                  "tokenPath": {
                    "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" }
                  }
                }
              }
            }
          }
        },
        "database": {
          "type": "object",
          "required": ["enabled"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "connectionEnv": { "$ref": "#/$defs/env" },
            "appsettings": {
              "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonempty" }
            },
            "connectionName": { "$ref": "#/$defs/nonempty", "default": "DefaultConnection" },
            "requestTimeout": { "$ref": "#/$defs/timeout", "default": 120000 }
          },
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "anyOf": [{ "required": ["connectionEnv"] }, { "required": ["appsettings"] }] }
        }
      }
    }
  },
  "$defs": {
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "ports": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/port" } },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "nonempty": { "type": "string", "minLength": 1 }
  },
  "examples": [{
    "kit": {
      "routing": { "frontendPorts": [8090], "apiPorts": [8490] },
      "api": {
        "ports": { "app": { "port": 8490, "protocol": "https" } },
        "timeoutMs": 30000,
        "login": {
          "primary": {
            "endpoint": "app:/example/session",
            "fields": { "username": "name", "password": "password" },
            "env": { "name": "BDD_TEST_USER", "password": "BDD_TEST_PASSWORD" },
            "tokenPath": ["session", "accessToken"]
          }
        }
      },
      "database": {
        "enabled": true,
        "connectionEnv": "BDD_TEST_CONNECTION",
        "appsettings": ["service/appsettings.json", "service/appsettings.Development.json"],
        "connectionName": "TestConnection"
      }
    }
  }]
}
