{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bdd-local-test.local/schemas/result.schema.json",
  "title": "Parallel BDD result contract v1",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "integer",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "groupId": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "taskStatus": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "interrupted"
      ]
    },
    "verification": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "roundIndex": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "roundIndex"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "execution": {
      "type": "object",
      "properties": {
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "uiUrl": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "apiUrl": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "serviceVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "tool",
        "uiUrl",
        "apiUrl",
        "serviceVersion"
      ],
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "changed",
              "regression"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not-run"
            ]
          },
          "expected": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "actual": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "feature",
          "id",
          "kind",
          "status",
          "expected",
          "actual",
          "reason",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "blocked",
                    "not-run"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "string",
                  "minLength": 1
                },
                "actual": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "report": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "masking": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "report",
        "masking"
      ],
      "additionalProperties": false
    },
    "modifiedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "scenarioIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "reason",
          "scenarioIds",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "rerunScenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "feature",
          "id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "resourceStates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "released": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "released"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contractVersion",
    "runId",
    "groupId",
    "attempt",
    "taskStatus",
    "verification",
    "execution",
    "scenarios",
    "artifacts",
    "modifiedPaths",
    "blockers",
    "rerunScenarios",
    "resourceStates"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
